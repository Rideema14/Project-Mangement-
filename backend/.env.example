# Local PostgreSQL connection. Replace YOUR_POSTGRES_PASSWORD with your local PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/neostats_pm?schema=public"
JWT_SECRET="replace-this-with-a-long-random-local-secret-at-least-32-characters"
PORT=4000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
