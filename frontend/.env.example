# Copy to `.env.local` and adjust. `.env.local` is gitignored.

# The Node Task Board API (auth, tasks, meetings) — everything src/lib/api talks
# to. Must match that backend's PORT (backend/.env sets PORT=4000).
#
# Do NOT point this at the Python meeting bot on :8000. The app sends ALL of its
# API traffic here, so the bot's port would 404 every request, login included.
NEXT_PUBLIC_API_URL=http://localhost:4000
