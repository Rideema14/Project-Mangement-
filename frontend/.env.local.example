# Base URL of the Task Board backend (Express).
# This is the ONLY environment variable the frontend needs.
#
# Zero Secrets Policy (Playbook, "Forms, Validation & Security"):
# NEXT_PUBLIC_* values are inlined into the browser bundle and are therefore
# public. Never put an API key, a JWT secret, or a database URL here — those
# live in the backend's own .env and never leave the server.
NEXT_PUBLIC_API_URL=http://localhost:4000
